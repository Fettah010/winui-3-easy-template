<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DevTemWinUi3.Controls.NotificationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Toast card layout (data applied once in code-behind: toasts are
         immutable). Fixed width: the host measures with unbounded width,
         where Star columns collapse and the card can measure to zero.
         NOTE: no Opacity here — NotificationService drives entrance/exit
         on the card itself; an Opacity="0" on this Border multiplies to
         invisible forever (every toast silently never rendered). -->
    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="14,12,10,12"
        Margin="0,0,16,8"
        Width="360">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon disc: a real Ellipse (a rounded Border rasterizes its
                 curve jagged at small sizes; the vector ellipse stays
                 smooth) with the glyph centered on top. -->
            <Grid
                Grid.Column="0"
                Width="30"
                Height="30"
                VerticalAlignment="Center">
                <Ellipse
                    x:Name="IconDisc"
                    Width="30"
                    Height="30"/>
                <FontIcon
                    x:Name="IconBlock"
                    FontSize="14"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <StackPanel
                Grid.Column="1"
                Orientation="Vertical"
                Spacing="0"
                MaxWidth="300">
                <TextBlock
                    x:Name="TitleBlock"
                    AutomationProperties.AutomationId="ToastCardTitle"
                    Text="{x:Bind Notification.Title, Mode=OneTime}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="300"/>
                <TextBlock
                    x:Name="MessageBlock"
                    Text="{x:Bind Notification.Message, Mode=OneTime}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords"
                    MaxWidth="300"
                    Margin="0,2,0,0"/>
            </StackPanel>

            <Button
                Grid.Column="2"
                Content="&#x2715;"
                FontSize="12"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Padding="8,4,8,4"
                Margin="8,-6,-4,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                MinWidth="0"
                MinHeight="0"
                Click="CloseButton_Click"/>
        </Grid>
    </Border>
</UserControl>

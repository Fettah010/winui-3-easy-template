<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:DevTemWinUi3.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:UpdatesPageViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="Updates" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock
                Text="Velopack keeps your app current. Check manually, then download and restart to install."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"/>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="STATUS"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard Header="Current version">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE737;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.CurrentVersion, Mode=OneWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Header="Update channel"
                    Description="The channel tags the app is packed with on GitHub Releases.">
                    <ctk:Segmented x:Name="ChannelSegment" SelectedIndex="{x:Bind ViewModel.SelectedChannelIndex, Mode=TwoWay}" HorizontalAlignment="Right">
                        <ctk:SegmentedItem Content="Stable"/>
                        <ctk:SegmentedItem Content="Beta"/>
                        <ctk:SegmentedItem Content="Dev"/>
                    </ctk:Segmented>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Header="Check for updates"
                    Description="Manually query GitHub Releases for a newer version.">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsCheckInProgress, Mode=OneWay}"
                            Width="20" Height="20"
                            VerticalAlignment="Center"/>
                        <Button
                            x:Name="CheckUpdateButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                <TextBlock Text="Check for Updates"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="AVAILABLE UPDATE"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <Border
                    Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE733;"
                            FontSize="24"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Update Available" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                <Border
                                    CornerRadius="6"
                                    Padding="8,2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Left">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.UpdateVersionTag, Mode=OneWay}"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.UpdateNotes, Mode=OneWay}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                MaxLines="3"
                                Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsDownloadInProgress, Mode=OneWay}"
                                IsIndeterminate="{x:Bind ViewModel.IsDownloadIndeterminate, Mode=OneWay}"
                                Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                                Width="20" Height="20"/>
                            <Button
                                Command="{x:Bind ViewModel.DownloadAndInstallCommand}"
                                IsEnabled="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                    <TextBlock Text="Download &amp; Install"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsUpToDate, Mode=OneWay}"
                    Severity="Success"
                    Title="You're up to date"
                    Message="{x:Bind ViewModel.UpToDateMessage, Mode=OneWay}"
                    IsClosable="False"/>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Severity="Error"
                    Title="Update check failed"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsClosable="True"/>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsNotInstalled, Mode=OneWay}"
                    Severity="Warning"
                    Title="Updates need an installed app"
                    Message="{x:Bind ViewModel.NotInstalledMessage, Mode=OneWay}"
                    IsClosable="True"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

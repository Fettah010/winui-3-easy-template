{
  "$schema": "http://json.schemastore.org/template",
  "author": "Fettah010",
  "classifications": [ "WinUI", "WinUI 3", "Page", "MVVM", "Template", "C#" ],
  "identity": "WinUI3.Page.MvvmI18n",
  "groupIdentity": "WinUI3.Page",
  "name": "WinUI 3 MVVM content page (i18n + responsive)",
  "shortName": "devtem-page",
  "description": "Content Page + code-behind (INavigationAware, live loc bindings, responsive) + transient ViewModel + MSTest stub + strings snippet. After scaffolding: paste SamplePage.strings.md into Services/Localization (then delete it), register the ViewModel, add the route - or run Scripts/add-page.ps1 once and skip every manual step (see docs/TEMPLATE-GUIDE.md).",
  "precedence": "0",
  "type": "item",
  "sourceName": "Sample",
  "defaultName": "Sample",
  "preferNameDirectory": false,
  "primaryOutputs": [
    { "path": "Pages/SamplePage.xaml" }
  ],
  "symbols": {
    "title": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "Sample",
      "replaces": "PageTitleFallback",
      "displayName": "Page title",
      "description": "Page title: seeds the en-US strings in the snippet (XAML binds live via {loc:Loc}; es/fr ship as TODO-translate in the strings snippet)."
    },
    "icon": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "Home", "description": "House (landing pages)." },
        { "choice": "Document", "description": "Paper sheet (default, generic content)." },
        { "choice": "Shop", "description": "Storefront (orders, catalog)." },
        { "choice": "Mail", "description": "Envelope (inbox, messages)." },
        { "choice": "Calendar", "description": "Calendar (schedule, history)." },
        { "choice": "People", "description": "Two figures (contacts, team)." },
        { "choice": "Globe", "description": "Globe (network, web)." },
        { "choice": "Pictures", "description": "Landscape photo (gallery)." },
        { "choice": "Video", "description": "Film strip (media)." },
        { "choice": "Camera", "description": "Camera (capture)." },
        { "choice": "Map", "description": "Folded map (locations)." },
        { "choice": "Phone", "description": "Handset (calls, devices)." }
      ],
      "defaultValue": "Document",
      "replaces": "TemplateIcon",
      "displayName": "Nav icon",
      "description": "Nav icon, a WinUI Symbol member (choice list guarantees validity). The value is also exposed as ViewModel.NavSymbol."
    }
  },
  "tags": {
    "language": "C#",
    "type": "item"
  }
}

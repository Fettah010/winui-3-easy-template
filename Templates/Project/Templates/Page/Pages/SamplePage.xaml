<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.SamplePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:DevTemWinUi3.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    Loaded="SamplePage_Loaded"
    SizeChanged="SamplePage_SizeChanged">

    <!-- Root Grid -> ScrollViewer (horizontal Disabled) -> viewport Grid ->
         content StackPanel with MaxWidth: the width never depends on content
         length, so translations wrap instead of shifting the layout
         (see docs/TEMPLATE-GUIDE.md "Layout rules"). -->
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <StackPanel x:Name="ContentPanel" Padding="32,24,32,32" Spacing="20" MaxWidth="980" HorizontalAlignment="Stretch">

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
                <StackPanel Spacing="8">
                    <!-- Labels bind live ({loc:Loc}); the title parameter seeds
                         the en-US strings in the snippet (wire-up step 2). -->
                    <TextBlock Text="{loc:Loc Key=SampleTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc Key=SampleDescription}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:loc="using:DevTemWinUi3.Controls"
    mc:Ignorable="d">

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock AutomationProperties.AutomationId="SetupWizardTitleText" Text="{loc:Loc Key=SetupWizardTitle}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>

            <PipsPager
                x:Name="SetupWizardPips"
                AutomationProperties.AutomationId="SetupWizardPips"
                NumberOfPages="5"
                SelectedPageIndex="{x:Bind ViewModel.SelectedStepIndex, Mode=TwoWay}"
                HorizontalAlignment="Center"/>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.WelcomeStepVisibility, Mode=OneWay}">
                <ctk:SettingsCard Header="{loc:Loc Key=SetupWizardWelcomeHeader}" Description="{loc:Loc Key=SetupWizardWelcomeBody}"/>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.LocationStepVisibility, Mode=OneWay}">
                <ctk:SettingsCard Header="{loc:Loc Key=SetupWizardLocationHeader}" Description="{loc:Loc Key=SetupWizardLocationDesc}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <TextBox
                            x:Name="SetupDataFolderBox"
                            AutomationProperties.AutomationId="SetupDataFolderBox"
                            Text="{x:Bind ViewModel.DataFolder, Mode=TwoWay}"
                            MinWidth="260"
                            IsReadOnly="True"/>
                        <Button
                            x:Name="SetupBrowseButton"
                            AutomationProperties.AutomationId="SetupBrowseButton"
                            Content="{loc:Loc Key=SetupWizardBrowse}"
                            Click="SetupBrowseButton_Click"/>
                    </StackPanel>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShortcutsStepVisibility, Mode=OneWay}">
                <ctk:SettingsCard Header="{loc:Loc Key=SetupWizardShortcutsHeader}" Description="{loc:Loc Key=SetupWizardShortcutsDesc}"/>
                <ctk:SettingsCard Header="{loc:Loc Key=SetupWizardDesktopShortcut}">
                    <ToggleSwitch
                        x:Name="SetupDesktopToggle"
                        AutomationProperties.AutomationId="SetupDesktopToggle"
                        IsOn="{x:Bind ViewModel.CreateDesktopShortcut, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
                <ctk:SettingsCard Header="{loc:Loc Key=SetupWizardStartShortcut}">
                    <ToggleSwitch
                        x:Name="SetupStartToggle"
                        AutomationProperties.AutomationId="SetupStartToggle"
                        IsOn="{x:Bind ViewModel.CreateStartShortcut, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.LaunchStepVisibility, Mode=OneWay}">
                <ctk:SettingsCard Header="{loc:Loc Key=SetupWizardLaunchHeader}" Description="{loc:Loc Key=SetupWizardLaunchDesc}">
                    <ToggleSwitch
                        x:Name="SetupLaunchToggle"
                        AutomationProperties.AutomationId="SetupLaunchToggle"
                        IsOn="{x:Bind ViewModel.LaunchAtLogin, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
                <ctk:SettingsCard Header="{loc:Loc Key=SetupWizardProtocolNote}" IsEnabled="False"/>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.DoneStepVisibility, Mode=OneWay}">
                <ctk:SettingsCard Header="{loc:Loc Key=SetupWizardDoneHeader}" Description="{loc:Loc Key=SetupWizardDoneBody}">
                    <FontIcon
                        AutomationProperties.AutomationId="SetupDoneGlyph"
                        Glyph="&#xE73E;"
                        FontSize="24"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button
                    x:Name="SetupWizardBackButton"
                    AutomationProperties.AutomationId="SetupWizardBackButton"
                    Content="{loc:Loc Key=SetupWizardBack}"
                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                    Click="SetupWizardBackButton_Click"/>
                <Button
                    x:Name="SetupWizardNextButton"
                    AutomationProperties.AutomationId="SetupWizardNextButton"
                    Content="{loc:Loc Key=SetupWizardNext}"
                    Visibility="{x:Bind ViewModel.NextButtonVisibility, Mode=OneWay}"
                    Click="SetupWizardNextButton_Click"
                    Style="{ThemeResource AccentButtonStyle}"/>
                <Button
                    x:Name="SetupWizardCompleteButton"
                    AutomationProperties.AutomationId="SetupWizardCompleteButton"
                    Content="{loc:Loc Key=SetupWizardComplete}"
                    Visibility="{x:Bind ViewModel.CompleteButtonVisibility, Mode=OneWay}"
                    Click="SetupWizardCompleteButton_Click"
                    Style="{ThemeResource AccentButtonStyle}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>

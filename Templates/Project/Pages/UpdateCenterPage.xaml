<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.UpdateCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:loc="using:DevTemWinUi3.Controls"
    mc:Ignorable="d">

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="980" HorizontalAlignment="Stretch">

            <TextBlock AutomationProperties.AutomationId="UpdateCenterTitleText" Text="{loc:Loc Key=UpdateCenterTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <ctk:SettingsCard
                Header="{x:Bind ViewModel.VersionLine, Mode=OneWay}"
                Description="{x:Bind ViewModel.StatusMessage, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button
                        x:Name="UpdateCheckButton"
                        AutomationProperties.AutomationId="UpdateCheckButton"
                        Content="{loc:Loc Key=SettingsCheckNow}"
                        IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}"
                        Click="UpdateCheckButton_Click"
                        Style="{ThemeResource AccentButtonStyle}"/>
                    <Button
                        x:Name="UpdateDownloadButton"
                        AutomationProperties.AutomationId="UpdateDownloadButton"
                        Content="{loc:Loc Key=UpdateCenterDownload}"
                        IsEnabled="{x:Bind ViewModel.CanDownload, Mode=OneWay}"
                        Click="UpdateDownloadButton_Click"/>
                    <Button
                        x:Name="UpdateInstallButton"
                        AutomationProperties.AutomationId="UpdateInstallButton"
                        Content="{loc:Loc Key=SettingsInstall}"
                        IsEnabled="{x:Bind ViewModel.CanInstall, Mode=OneWay}"
                        Click="UpdateInstallButton_Click"/>
                </StackPanel>
            </ctk:SettingsCard>

            <ProgressBar
                x:Name="UpdateProgressBar"
                AutomationProperties.AutomationId="UpdateProgressBar"
                Minimum="0" Maximum="100"
                Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}"
                ShowPaused="False" ShowError="False"/>

            <ctk:SettingsCard
                Header="{loc:Loc Key=UpdateCenterNotesHeader}"
                Visibility="{x:Bind ViewModel.NotesVisibility, Mode=OneWay}"
                HorizontalContentAlignment="Stretch">
                <TextBlock
                    x:Name="UpdateNotesText"
                    Text="{x:Bind ViewModel.ReleaseNotes, Mode=OneWay}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"/>
            </ctk:SettingsCard>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>

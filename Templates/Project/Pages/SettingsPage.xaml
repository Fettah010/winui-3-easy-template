<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled"
    Loaded="SettingsPage_Loaded">

    <!-- DataContext (SettingsPageViewModel) is resolved from the DI container
         in code-behind, never newed up in XAML. -->

    <Grid>
        <!-- Narrow windows get tighter page padding so cards keep breathing room. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsPanel.Padding" Value="16,16,16,24"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Grid wrapper: forces viewport-width measure so the inner panel is
             always exactly min(viewport, MaxWidth), positioned identically in
             every language. A bare StackPanel sizes to its longest unwrapped
             line, which moved the whole page when translations changed length. -->
        <Grid>
        <StackPanel x:Name="SettingsPanel" Padding="32,24,32,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock x:Name="SettingsTitleText" AutomationProperties.AutomationId="SettingsTitleText" Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock
                x:Name="SettingsDescText"
                Text="Customize the appearance and behavior of the app."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"/>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="SettingsAppearanceText"
                    Text="APPEARANCE"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    x:Name="ThemeCard"
                    Header="Theme"
                    Description="Choose between light, dark, or system theme.">
                    <ComboBox
                        x:Name="ThemeComboBox"
                        AutomationProperties.AutomationId="ThemeComboBox"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                        HorizontalAlignment="Right"
                        MinWidth="120">
                        <ComboBoxItem x:Name="ThemeSystemItem" Content="System"/>
                        <ComboBoxItem x:Name="ThemeLightItem" Content="Light"/>
                        <ComboBoxItem x:Name="ThemeDarkItem" Content="Dark"/>
                    </ComboBox>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="SettingsLanguageText"
                    Text="Language"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard x:Name="LanguageCard" Header="Language" Description="Choose the display language for the app.">
                    <ComboBox
                        x:Name="LanguageComboBox"
                        AutomationProperties.AutomationId="LanguageComboBox"
                        HorizontalAlignment="Right"
                        MinWidth="140"
                        SelectionChanged="LanguageComboBox_SelectionChanged"/>
                </ctk:SettingsCard>
            </StackPanel>

            <!-- Feature sections are collapsed at runtime via AppFeatures when
                 their flag was scaffolded off (see ApplyLocalization). -->
            <StackPanel x:Name="UpdatesSection" Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="SettingsUpdatesText"
                    Text="UPDATES"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    x:Name="ChannelCard"
                    Header="Update channel"
                    Description="The channel determines which release feed the app checks for updates.">
                    <ctk:Segmented
                        x:Name="ChannelSegment"
                        SelectedIndex="{x:Bind ViewModel.SelectedChannelIndex, Mode=TwoWay}"
                        HorizontalAlignment="Right">
                        <ctk:SegmentedItem Content="Stable"/>
                        <ctk:SegmentedItem Content="Beta"/>
                    </ctk:Segmented>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    x:Name="CheckUpdatesCard"
                    Header="Check for updates"
                    Description="Manually check for new versions on the selected channel.">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button
                            x:Name="CheckUpdatesButton"
                            Content="Check now"
                            Click="CheckUpdatesButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    x:Name="AutoCheckCard"
                    Header="Check for updates on startup"
                    Description="Automatically check for updates when the app starts.">
                    <ToggleSwitch
                        x:Name="AutoCheckToggle"
                        IsOn="{x:Bind ViewModel.AutoCheckOnStartup, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    x:Name="UpdateStatusCard"
                    Header="Update status"
                    Description="No check performed yet."
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <ProgressBar
                            x:Name="DownloadProgressBar"
                            Width="140"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            ShowPaused="False"
                            ShowError="False"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            x:Name="UpdateStatusText"
                            Text=""
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            MaxWidth="200"
                            TextWrapping="Wrap"/>
                        <Button
                            x:Name="InstallUpdateButton"
                            Content="Install"
                            Click="InstallUpdateButton_Click"
                            Visibility="Collapsed"/>
                    </StackPanel>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel x:Name="TraySection" Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="SettingsSystemTrayText"
                    Text="SYSTEM TRAY"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    x:Name="MinimizeCard"
                    Header="Minimize to system tray"
                    Description="When closed, the app minimizes to the system tray instead of exiting.">
                    <ToggleSwitch
                        x:Name="MinimizeToTrayToggle"
                        IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    x:Name="AutoStartCard"
                    Header="Start automatically with Windows"
                    Description="Launch the app when you sign in to Windows.">
                    <ToggleSwitch
                        x:Name="AutoStartToggle"
                        IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.AutoStartAvailable, Mode=OneWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="SettingsAboutText"
                    Text="ABOUT"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard x:Name="AppVersionCard" Header="App version">
                    <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneTime}" VerticalAlignment="Center"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard x:Name="RepoCard" Header="Repository">
                    <HyperlinkButton
                        Content="GitHub"
                        NavigateUri="https://github.com/Fettah010/winui-3-easy-template"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

        </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>

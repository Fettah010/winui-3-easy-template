{
  "$schema": "http://json.schemastore.org/template",
  "author": "WinUI 3 template contributors",
  "classifications": [ "WinUI", "WinUI 3", "Desktop", "MVVM" ],
  "identity": "WinUI3.App.TrayUpdatesDb",
  "groupIdentity": "WinUI3.App",
  "name": "DevTem",
  "shortName": "devtem-winui",
  "description": "Unpackaged WinUI 3 app: Mica window, optional system tray, optional Velopack auto-updates, optional SQLite and HTTP services, 3-language UI, persisted settings, Serilog, release tooling, and profile-aware documentation. Identity and features are scaffold-time parameters; see docs/TEMPLATE-GUIDE.md in the scaffolded app.",
  "type": "project",
  "sourceName": "DevTemWinUi3",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "safeName": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "fileRename": "__SafeName__",
      "replaces": "DevTemWinUi3",
      "parameters": {
        "source": "name",
        "steps": [
          { "regex": "^[^A-Za-z]+", "replacement": "_" },
          { "regex": "^_[0-9]+", "replacement": "_" },
          { "regex": "[^A-Za-z0-9_]", "replacement": "_" }
        ]
      },
      "description": "Identifier-safe form of the project name. A leading non-letter prefix becomes '_', other unsupported characters become '_', and the result drives project files, namespace, assembly, and process identity."
    },
    "displayName": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Display name",
      "defaultValue": "My App",
      "replaces": "DevTem-WinUI 3",
      "description": "Display name used in titles, toasts and the installer."
    },
    "company": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Company",
      "defaultValue": "Contoso",
      "replaces": "Fettah",
      "description": "Pack author."
    },
    "repo": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "GitHub repository",
      "defaultValue": "myorg/my-app",
      "replaces": "Fettah010/winui-3-easy-template",
      "description": "GitHub repo path (org/name) used for feeds, links and CI."
    },
    "scheme": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Deep-link URI scheme",
      "defaultValue": "myapp://",
      "replaces": "devtem://",
      "description": "Lowercase deep-link URI scheme including :// (e.g. --scheme acme://)."
    },
    "schemeName": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "displayName": "Deep-link scheme name",
      "parameters": {
        "source": "scheme",
        "steps": [
          { "regex": "^(.*)://$", "replacement": "Name=\"$1\"" }
        ]
      },
      "replaces": "Name=\"devtem\"",
      "description": "Full manifest protocol attribute (Name=\"…\") derived from the scheme; replaces replaces the whole match, so the value must carry the wrapper."
    },
    "tray": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "System tray",
      "defaultValue": "true",
      "replaces": "__TRAY__",
      "description": "Include minimize-to-tray, autostart and desktop toasts (--tray false to drop)."
    },
    "updates": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Velopack auto-updates",
      "defaultValue": "true",
      "replaces": "__UPDATES__",
      "description": "Include Velopack auto-updates, channels and the release pipeline (--updates false to drop)."
    },
    "database": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "SQLite database",
      "defaultValue": "true",
      "replaces": "__DATABASE__",
      "description": "Include SQLite persistence and deferred database initialization (--database false to drop)."
    },
    "http": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "HTTP client",
      "defaultValue": "true",
      "replaces": "__HTTP__",
      "description": "Include the typed HTTP client and HttpClientFactory registration (--http false to drop)."
    },
    "attribution": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "DevTem attribution",
      "defaultValue": "true",
      "replaces": "__ATTRIBUTION__",
      "description": "Keep DevTemAttribution.cs with a one-line source comment (--attribution false to omit)."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!tray)",
          "exclude": [
            "Services/SystemTrayService.cs",
            "Services/DesktopToastService.cs",
            "Tests/Services/DesktopToastServiceTests.cs"
          ]
        },
        {
          "condition": "(!updates)",
          "exclude": [
            "Services/UpdateService.cs",
            "Services/BackgroundUpdateService.cs",
            "Build/Features.Updates.props",
            "Tests/Services/UpdateServiceTests.cs",
            "Tests/Services/BackgroundUpdateServiceTests.cs",
            ".github/workflows/release.yml",
            "Scripts/build-and-release.ps1",
            "Scripts/local-smoke-test.ps1",
            "Scripts/upload-github.ps1"
          ]
        },
        {
          "condition": "(!database)",
          "exclude": [
            "Services/DatabaseService.cs",
            "Services/DatabaseInitializer.cs",
            "Build/Features.Database.props",
            "Tests/Services/DatabaseServiceTests.cs",
            "Tests/Services/DatabaseInitializerTests.cs"
          ]
        },
        {
          "condition": "(!http)",
          "exclude": [
            "Services/ApiService.cs",
            "Build/Features.Http.props",
            "Tests/Services/ApiServiceTests.cs"
          ]
        },
        {
          "condition": "(!attribution)",
          "exclude": [
            "DevTemAttribution.cs"
          ]
        },
        {
          "condition": "(!tray)",
          "exclude": [
            "docs/feature-guides/tray.md"
          ]
        },
        {
          "condition": "(!updates)",
          "exclude": [
            "docs/feature-guides/updates.md"
          ]
        },
        {
          "condition": "(!database)",
          "exclude": [
            "docs/feature-guides/database.md"
          ]
        },
        {
          "condition": "(!http)",
          "exclude": [
            "docs/feature-guides/http.md"
          ]
        }
      ]
    }
  ]
}

{
  "$schema": "http://json.schemastore.org/template",
  "author": "WinUI 3 template contributors",
  "classifications": [ "WinUI", "WinUI 3", "Desktop", "MVVM" ],
  "identity": "WinUI3.App.TrayUpdatesDb",
  "groupIdentity": "WinUI3.App",
  "name": "DevTem",
  "shortName": "devtem-winui",
  "description": "WinUI 3 app: Mica window, optional system tray, optional auto-updates (Velopack, basic checker, or none — or native AppInstaller / Store updates for packaged MSIX), optional SQLite, HTTP, diagnostics, crash reporting, and 3-language UI (or English-only), persisted settings, flexible logging (Serilog by default), optional MSTest suite, optional first-run setup wizard (portable only), release tooling, and profile-aware documentation. Identity, distribution and features are scaffold-time parameters; see docs/TEMPLATE-GUIDE.md in the scaffolded app.",
  "type": "project",
  "sourceName": "DevTemWinUi3",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "safeName": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "fileRename": "__SafeName__",
      "replaces": "DevTemWinUi3",
      "parameters": {
        "source": "name",
        "steps": [
          { "regex": "^[^A-Za-z]+", "replacement": "_" },
          { "regex": "^_[0-9]+", "replacement": "_" },
          { "regex": "[^A-Za-z0-9_]", "replacement": "_" }
        ]
      },
      "description": "Identifier-safe form of the project name. A leading non-letter prefix becomes '_', other unsupported characters become '_', and the result drives project files, namespace, assembly, and process identity."
    },
    "displayName": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Display name",
      "defaultValue": "My App",
      "replaces": "DevTem-WinUI 3",
      "description": "Display name used in titles, toasts and the installer."
    },
    "company": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Company",
      "defaultValue": "Contoso",
      "replaces": "Fettah",
      "description": "Pack author."
    },
    "repo": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "GitHub repository",
      "defaultValue": "myorg/my-app",
      "replaces": "Fettah010/winui-3-easy-template",
      "description": "GitHub repo path (org/name) used for feeds, links and CI."
    },
    "scheme": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Deep-link URI scheme",
      "defaultValue": "myapp://",
      "replaces": "devtem://",
      "description": "Lowercase deep-link URI scheme including :// (e.g. --scheme acme://)."
    },
    "schemeName": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "displayName": "Deep-link scheme name",
      "parameters": {
        "source": "scheme",
        "steps": [
          { "regex": "^(.*)://$", "replacement": "Name=\"$1\"" }
        ]
      },
      "replaces": "Name=\"devtem\"",
      "description": "Full manifest protocol attribute (Name=\"…\") derived from the scheme; replaces replaces the whole match, so the value must carry the wrapper."
    },
    "tray": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "System tray",
      "defaultValue": "true",
      "replaces": "__TRAY__",
      "description": "Include minimize-to-tray, autostart and desktop toasts (--tray false to drop)."
    },
    "updates": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Auto-updates",
      "defaultValue": "velopack",
      "choices": [
        {
          "choice": "velopack",
          "description": "Velopack auto-updates: installer, delta downloads, release pipeline (default)."
        },
        {
          "choice": "basic",
          "description": "Zero-dependency GitHub-releases checker: notify + download a Setup .exe, no SDK."
        },
        {
          "choice": "none",
          "description": "No update code, scripts, or CI release job."
        },
        {
          "choice": "appinstaller",
          "description": "Native MSIX auto-updates via an .appinstaller feed for sideloaded packaged apps (requires --distribution msix)."
        },
        {
          "choice": "store",
          "description": "Microsoft Store updates for packaged apps; no updater code is scaffolded (requires --distribution msix)."
        }
      ],
      "replaces": "__UPDATES__",
      "description": "Update mechanism: velopack (full), basic (checker only), none — or appinstaller / store for packaged MSIX (--distribution msix)."
    },
    "distribution": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Distribution",
      "defaultValue": "portable",
      "choices": [
        {
          "choice": "portable",
          "description": "Unpackaged app: own folder, file-replace updates, custom setup wizard (default)."
        },
        {
          "choice": "msix",
          "description": "Packaged MSIX with identity: Store submission or sideload with native updates. Only pairs with --updates appinstaller, store, or none."
        }
      ],
      "replaces": "__DISTRIBUTION__",
      "description": "Distribution format: portable (unpackaged) or msix (packaged, for Store or sideload)."
    },
    "setup": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Setup wizard",
      "defaultValue": "true",
      "replaces": "__SETUP__",
      "description": "Include the first-run setup wizard: install location, shortcuts, launch options (--setup false to drop; portable only, ignored for msix)."
    },
    "publisher": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "MSIX publisher",
      "defaultValue": "CN=DevTem",
      "replaces": "CN=DevTem",
      "description": "Publisher ID for MSIX packaging: your Partner Center Publisher ID (Store) or signing cert subject (sideload). Pre-fills the manifest and build-msix.ps1; per-run -Publisher still wins."
    },
    "database": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "SQLite database",
      "defaultValue": "true",
      "replaces": "__DATABASE__",
      "description": "Include SQLite persistence and deferred database initialization (--database false to drop)."
    },
    "http": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "HTTP client",
      "defaultValue": "true",
      "replaces": "__HTTP__",
      "description": "Include the typed HTTP client and HttpClientFactory registration (--http false to drop)."
    },
    "health": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Diagnostics page",
      "defaultValue": "true",
      "replaces": "__HEALTH__",
      "description": "Include the in-app diagnostics page (status, log viewer, metrics) (--health false to drop)."
    },
    "logging": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Logging backend",
      "defaultValue": "serilog",
      "choices": [
        {
          "choice": "serilog",
          "description": "Serilog: debugger console + 14-day rolling files + JSON sidecar (default)."
        },
        {
          "choice": "mel",
          "description": "Microsoft.Extensions.Logging only: debugger + Event Log + in-app buffer. No log files."
        },
        {
          "choice": "none",
          "description": "No logging packages. The in-app buffer stays only when health is on."
        }
      ],
      "replaces": "__LOGGING__",
      "description": "Logging backend: serilog (files), mel (no files), or none (--logging mel)."
    },
    "attribution": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "DevTem attribution",
      "defaultValue": "true",
      "replaces": "__ATTRIBUTION__",
      "description": "Keep DevTemAttribution.cs with a one-line source comment (--attribution false to omit)."
    },
    "crash": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Crash reporting (Sentry)",
      "defaultValue": "true",
      "replaces": "__CRASH__",
      "description": "Include Sentry crash reporting behind the veneer (DSN-gated, off until configured) (--crash false to drop the SDK)."
    },
    "localization": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Three-language UI",
      "defaultValue": "true",
      "replaces": "__LOCALIZATION__",
      "description": "Include Spanish and French dictionaries + the language picker (--localization false for English-only)."
    },
    "tests": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "MSTest suite",
      "defaultValue": "true",
      "replaces": "__TESTS__",
      "description": "Include the MSTest suite sources (--tests false keeps an empty test project shell)."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!tray)",
          "exclude": [
            "Services/SystemTrayService.cs",
            "Services/DesktopToastService.cs",
            "Tests/Services/DesktopToastServiceTests.cs"
          ]
        },
        {
          "condition": "(updates != 'velopack')",
          "exclude": [
            "Services/UpdateService.cs",
            "Build/Features.Updates.Velopack.props",
            "Tests/Services/UpdateServiceTests.cs",
            "Tests/Services/BackgroundUpdateServiceTests.cs",
            ".github/workflows/release.yml",
            "Scripts/build-and-release.ps1",
            "Scripts/Invoke-GithubParallelUpload.ps1",
            "Scripts/local-smoke-test.ps1",
            "Scripts/upload-github.ps1",
            "docs/feature-guides/updates-velopack.md"
          ]
        },
        {
          "condition": "(updates != 'basic')",
          "exclude": [
            "Services/BasicGithubUpdateService.cs",
            "Build/Features.Updates.Basic.props",
            "Scripts/publish-basic.ps1",
            "Tests/Services/BasicGithubUpdateServiceTests.cs",
            "docs/feature-guides/updates-basic.md"
          ]
        },
        {
          "condition": "(updates == 'none')",
          "exclude": [
            "Services/BackgroundUpdateService.cs"
          ]
        },
        {
          "condition": "(updates == 'appinstaller')",
          "exclude": [
            "Services/BackgroundUpdateService.cs"
          ]
        },
        {
          "condition": "(updates == 'store')",
          "exclude": [
            "Services/BackgroundUpdateService.cs"
          ]
        },
        {
          "condition": "(updates != 'appinstaller')",
          "exclude": [
            "docs/feature-guides/updates-appinstaller.md"
          ]
        },
        {
          "condition": "(updates != 'store')",
          "exclude": [
            "docs/feature-guides/updates-store.md"
          ]
        },
        {
          "condition": "(distribution != 'msix')",
          "exclude": [
            "docs/feature-guides/distribution-msix.md",
            ".github/workflows/store-submit.yml"
          ]
        },
        {
          "condition": "(!setup)",
          "exclude": [
            "docs/feature-guides/setup-wizard.md",
            "Pages/SetupWizardPage.xaml",
            "Pages/SetupWizardPage.xaml.cs",
            "ViewModels/SetupWizardViewModel.cs",
            "Services/SetupWizardService.cs",
            "Tests/ViewModels/SetupWizardViewModelTests.cs"
          ]
        },
        {
          "condition": "(logging != 'serilog')",
          "exclude": [
            "Services/Diagnostics/SerilogLogEntrySink.cs",
            "Services/Diagnostics/EventLogSink.cs",
            "Services/Diagnostics/ThreadIdEnricher.cs",
            "Build/Features.Logging.Serilog.props",
            "docs/feature-guides/logging-serilog.md"
          ]
        },
        {
          "condition": "(logging != 'mel')",
          "exclude": [
            "Services/Diagnostics/EventLogLoggerProvider.cs",
            "Build/Features.Logging.Mel.props",
            "docs/feature-guides/logging-mel.md"
          ]
        },
        {
          "condition": "(logging == 'none')",
          "exclude": [
            "Build/Features.Logging.props"
          ]
        },
        {
          "condition": "(!database)",
          "exclude": [
            "Services/DatabaseService.cs",
            "Services/DatabaseInitializer.cs",
            "Build/Features.Database.props",
            "Tests/Services/DatabaseServiceTests.cs",
            "Tests/Services/DatabaseInitializerTests.cs"
          ]
        },
        {
          "condition": "(!http)",
          "exclude": [
            "Services/ApiService.cs",
            "Build/Features.Http.props",
            "Tests/Services/ApiServiceTests.cs"
          ]
        },
        {
          "condition": "(!health)",
          "exclude": [
            "Pages/DiagnosticsPage.xaml",
            "Pages/DiagnosticsPage.xaml.cs",
            "ViewModels/DiagnosticsPageViewModel.cs",
            "Services/Native/CrashDialogNative.cs",
            "Tests/ViewModels/DiagnosticsPageViewModelTests.cs"
          ]
        },
        {
          "condition": "(!attribution)",
          "exclude": [
            "DevTemAttribution.cs"
          ]
        },
        {
          "condition": "(!crash)",
          "exclude": [
            "Services/SentryCrashReporter.cs",
            "Build/Features.Crash.props"
          ]
        },
        {
          "condition": "(!crash)",
          "exclude": [
            "docs/feature-guides/crash.md"
          ]
        },
        {
          "condition": "(!localization)",
          "exclude": [
            "Services/Localization/EsStrings.cs",
            "Services/Localization/FrStrings.cs",
            "Tests/Services/LocalizationCoverageTests.cs",
            "Tests/Services/LocalizationServiceTests.cs"
          ]
        },
        {
          "condition": "(!tests)",
          "exclude": [
            "Tests/**/*.cs"
          ]
        },
        {
          "condition": "(!tray)",
          "exclude": [
            "docs/feature-guides/tray.md"
          ]
        },
        {
          "condition": "(!database)",
          "exclude": [
            "docs/feature-guides/database.md"
          ]
        },
        {
          "condition": "(!http)",
          "exclude": [
            "docs/feature-guides/http.md"
          ]
        },
        {
          "condition": "(!health)",
          "exclude": [
            "docs/feature-guides/diagnostics.md"
          ]
        }
      ]
    }
  ]
}

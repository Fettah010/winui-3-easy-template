<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest. Packaged with Scripts/build-msix.ps1, which syncs
  Identity Name/Version/Publisher, generates tile art from Assets/Logo.png,
  and calls makeappx (plus optional signtool signing).

  Publisher MUST match your signing certificate subject. The default below
  is a placeholder — pass -Publisher with your Publisher ID (Partner Center)
  or cert subject (sideload), e.g. "CN=Acme". The publisher template
  parameter pre-fills it at scaffold time.
  The StartupTask is registered disabled: users enable it in Windows
  Settings > Apps > Startup. Registry autostart (HKCU Run) does not apply
  to packaged runs — the app disables that toggle itself (AppInfo.IsPackaged).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10">

  <Identity
    Name="DevTemWinUi3"
    Publisher="CN=DevTem"
    Version="0.0.5.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DevTem-WinUI 3</DisplayName>
    <PublisherDisplayName>Fettah</PublisherDisplayName>
    <Description>A modern Windows 11 app built with WinUI 3.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="es-ES" />
    <Resource Language="fr-FR" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>

  <Applications>
    <Application
      Id="App"
      Executable="DevTemWinUi3.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DevTem-WinUI 3"
        Description="A modern Windows 11 app built with WinUI 3."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension
          Category="windows.fullTrustProcess"
          Executable="DevTemWinUi3.exe" />
        <desktop:Extension
          Category="windows.startupTask"
          Executable="DevTemWinUi3.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="DevTemWinUi3Startup"
            Enabled="false"
            DisplayName="DevTem-WinUI 3 startup" />
        </desktop:Extension>
        <!-- Deep-link scheme (devtem://…): packaged installs register here;
             unpackaged runs self-register HKCU on startup (ProtocolService).
             Renamed apps change Name alongside init-template/template.json. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="devtem">
            <uap:DisplayName>DevTem-WinUI 3</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>

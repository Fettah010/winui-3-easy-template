<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:loc="using:DevTemWinUi3.Controls"
    xmlns:ctrl="using:DevTemWinUi3.Controls"
    xmlns:svc="using:DevTemWinUi3.Services"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled"
    SizeChanged="DiagnosticsPage_SizeChanged">

    <!-- DataContext (DiagnosticsPageViewModel) is resolved from the DI container
         in code-behind BEFORE InitializeComponent so compiled bindings
         ({x:Bind ViewModel.…}) see it on first evaluation, never newed up in XAML. -->

    <!-- Responsive padding lives in DiagnosticsPage.xaml.cs
         UpdateResponsiveLayout (code-behind, like every page): VSM setters
         cannot retarget Grid rows/columns, so one mechanism covers
         padding AND grids. -->

    <!-- devtem:optional:diagnostics-page — the whole page is droppable.
         Removal checklist: delete this file + DiagnosticsPage.xaml.cs +
         ViewModels/DiagnosticsPageViewModel.cs (+ its test), the
         "diagnostics" route in MainWindow.xaml.cs, the footer entry in
         Services/NavigationRegistry.cs, the ViewModel + PageFactory
         registrations in Services/ServiceLocator.cs, and the Diagnostics*
         keys in Services/Localization/*Strings.cs (optional: unused keys
         are harmless, but LocalizationCoverageTests asserts none are
         hardcoded versions). See docs/TEMPLATE-GUIDE.md §2d. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Viewport wrapper: the panel fills min(viewport, 820) and centers
             above the cap by design. The overlay pane never resizes the
             content, so toggles move nothing — width only changes on window
             resizes. -->
        <Grid>
        <StackPanel x:Name="DiagnosticsPanel" Padding="32,24,32,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock AutomationProperties.AutomationId="DiagnosticsTitleText" Text="{loc:Loc Key=DiagnosticsTitle}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock
                Text="{loc:Loc Key=DiagnosticsDesc}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"/>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=DiagnosticsStatus}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=DiagnosticsStatus}">
                    <TextBlock
                        x:Name="StatusText"
                        AutomationProperties.AutomationId="DiagnosticsStatusText"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Right"
                        TextAlignment="Right"
                        IsTextSelectionEnabled="True"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=DiagnosticsVerbose}"
                    Description="{loc:Loc Key=DiagnosticsVerboseDesc}">
                    <ToggleSwitch
                        x:Name="VerboseToggle"
                        AutomationProperties.AutomationId="DiagnosticsVerboseToggle"
                        IsOn="{x:Bind ViewModel.VerboseLogging, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=DiagnosticsCrashReports}"
                    Description="{loc:Loc Key=DiagnosticsCrashReportsDesc}"
                    Visibility="{x:Bind ViewModel.CrashReportingVisibility, Mode=OneWay}">
                    <ToggleSwitch
                        x:Name="CrashReportsToggle"
                        AutomationProperties.AutomationId="DiagnosticsCrashReportsToggle"
                        IsOn="{x:Bind ViewModel.CrashReportingEnabled, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=DiagnosticsMetrics}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=DiagnosticsMetrics}">
                    <TextBlock
                        x:Name="MetricsText"
                        AutomationProperties.AutomationId="DiagnosticsMetricsText"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Right"
                        TextAlignment="Right"
                        IsTextSelectionEnabled="True"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=DiagnosticsLogs}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard>
                    <ctk:Segmented
                        x:Name="ViewSegment"
                        AutomationProperties.AutomationId="DiagnosticsViewSegment"
                        SelectedIndex="{x:Bind ViewModel.SelectedViewIndex, Mode=TwoWay}"
                        HorizontalAlignment="Right">
                        <ctk:SegmentedItem Content="{loc:Loc Key=DiagnosticsViewFile}"/>
                        <ctk:SegmentedItem Content="{loc:Loc Key=DiagnosticsViewLive}"/>
                    </ctk:Segmented>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=DiagnosticsLogs}"
                    Visibility="{x:Bind ViewModel.FileViewVisibility, Mode=OneWay}">
                    <!-- WrapPanel (not StackPanel): longer translations wrap
                         instead of clipping on narrow windows. -->
                    <ctrl:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Right">
                        <ComboBox
                            x:Name="LogFileComboBox"
                            AutomationProperties.AutomationId="LogFileComboBox"
                            ItemsSource="{x:Bind ViewModel.LogFiles, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedLogFile, Mode=TwoWay}"
                            MinWidth="180"/>
                        <Button
                            AutomationProperties.AutomationId="RefreshLogsButton"
                            Content="{loc:Loc Key=DiagnosticsRefresh}"
                            Click="RefreshLogsButton_Click"/>
                        <Button
                            AutomationProperties.AutomationId="OpenLogFolderButton"
                            Content="{loc:Loc Key=DiagnosticsOpenFolder}"
                            Click="OpenLogFolderButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    </ctrl:WrapPanel>
                </ctk:SettingsCard>

                <!-- Live toolbar: source filter + exception/regex toggles. -->
                <ctk:SettingsCard
                    Visibility="{x:Bind ViewModel.LiveViewVisibility, Mode=OneWay}">
                    <ctrl:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Stretch">
                        <TextBox
                            x:Name="SourceBox"
                            AutomationProperties.AutomationId="DiagnosticsSourceBox"
                            PlaceholderText="{loc:Loc Key=DiagnosticsSourcePlaceholder}"
                            Text="{x:Bind ViewModel.LiveSourceFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            MinWidth="180"/>
                        <CheckBox
                            x:Name="ExceptionsCheck"
                            AutomationProperties.AutomationId="DiagnosticsExceptionsCheck"
                            Content="{loc:Loc Key=DiagnosticsExceptionsOnly}"
                            IsChecked="{x:Bind ViewModel.ExceptionsOnly, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                        <CheckBox
                            x:Name="RegexCheck"
                            AutomationProperties.AutomationId="DiagnosticsRegexCheck"
                            Content="{loc:Loc Key=DiagnosticsUseRegex}"
                            IsChecked="{x:Bind ViewModel.UseRegex, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    </ctrl:WrapPanel>
                </ctk:SettingsCard>

                <!-- Filter row: search + level + copy/clear. Plain card so the
                     viewer below stays the visual focus. -->
                <ctk:SettingsCard>
                    <ctrl:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Stretch">
                        <TextBox
                            x:Name="SearchBox"
                            AutomationProperties.AutomationId="DiagnosticsSearchBox"
                            PlaceholderText="{loc:Loc Key=DiagnosticsSearchPlaceholder}"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            MinWidth="180"/>
                        <ComboBox
                            x:Name="LevelComboBox"
                            AutomationProperties.AutomationId="DiagnosticsLevelCombo"
                            SelectedIndex="{x:Bind ViewModel.SelectedLevelIndex, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.FileViewVisibility, Mode=OneWay}"
                            MinWidth="140">
                            <ComboBoxItem Content="{loc:Loc Key=DiagnosticsLevelAll}"/>
                            <ComboBoxItem Content="{loc:Loc Key=DiagnosticsLevelDebug}"/>
                            <ComboBoxItem Content="{loc:Loc Key=DiagnosticsLevelInfo}"/>
                            <ComboBoxItem Content="{loc:Loc Key=DiagnosticsLevelWarning}"/>
                            <ComboBoxItem Content="{loc:Loc Key=DiagnosticsLevelError}"/>
                        </ComboBox>
                        <Button
                            x:Name="CopyButton"
                            AutomationProperties.AutomationId="DiagnosticsCopyButton"
                            Content="{loc:Loc Key=DiagnosticsCopy}"
                            Click="CopyButton_Click"/>
                        <Button
                            AutomationProperties.AutomationId="DiagnosticsClearButton"
                            Content="{loc:Loc Key=DiagnosticsClear}"
                            Click="ClearButton_Click"/>
                    </ctrl:WrapPanel>
                </ctk:SettingsCard>

                <TextBlock
                    x:Name="LogCountText"
                    AutomationProperties.AutomationId="DiagnosticsLogCountText"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Visibility="{x:Bind ViewModel.FileViewVisibility, Mode=OneWay}">
                    <ScrollViewer x:Name="FileScrollViewer" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock
                                x:Name="LogText"
                                AutomationProperties.AutomationId="DiagnosticsLogText"
                                Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                                FontFamily="Consolas"
                                FontSize="12"
                                TextWrapping="NoWrap"
                                IsTextSelectionEnabled="True"/>
                            <!-- Empty state is a SEPARATE element: writing the
                                 placeholder into LogText would clobber the
                                 compiled binding above. -->
                            <TextBlock
                                x:Name="EmptyStateText"
                                AutomationProperties.AutomationId="DiagnosticsEmptyText"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Live view: virtualized event list fed by the ring buffer. -->
                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.LiveViewVisibility, Mode=OneWay}">
                    <Button
                        x:Name="NewEventsButton"
                        AutomationProperties.AutomationId="DiagnosticsNewEventsButton"
                        HorizontalAlignment="Right"
                        Click="NewEventsButton_Click"
                        Visibility="Collapsed"/>
                    <TextBlock
                        x:Name="LiveEmptyText"
                        AutomationProperties.AutomationId="DiagnosticsLiveEmptyText"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"/>
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <ListView
                            x:Name="LiveList"
                            AutomationProperties.AutomationId="DiagnosticsLiveList"
                            ItemsSource="{x:Bind ViewModel.LiveEvents, Mode=OneWay}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="LiveList_ItemClick"
                            MaxHeight="320"
                            FontFamily="Consolas"
                            FontSize="12">
                            <ListView.ItemTemplate>
                                <!-- Compiled bindings (x:DataType): mistyped row
                                     paths fail the build. BufferedLogEvent is
                                     top-level in DevTemWinUi3.Services exactly
                                     so this can name it. -->
                                <DataTemplate x:DataType="svc:BufferedLogEvent">
                                    <StackPanel Spacing="2" Padding="0,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind DisplayTime, Mode=OneTime}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{x:Bind Level, Mode=OneTime}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind SourceContext, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Message, Mode=OneTime}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=DiagnosticsExport}">
                    <ctrl:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Right">
                        <Button
                            AutomationProperties.AutomationId="DiagnosticsSaveViewButton"
                            Content="{loc:Loc Key=DiagnosticsSaveView}"
                            Click="SaveViewButton_Click"/>
                        <Button
                            AutomationProperties.AutomationId="DiagnosticsExportBundleButton"
                            Content="{loc:Loc Key=DiagnosticsExportBundle}"
                            Click="ExportBundleButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    </ctrl:WrapPanel>
                </ctk:SettingsCard>
            </StackPanel>

        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:loc="using:DevTemWinUi3.Controls"
    xmlns:ctrl="using:DevTemWinUi3.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <!-- DataContext (DiagnosticsPageViewModel) is resolved from the DI container
         in code-behind BEFORE InitializeComponent so compiled bindings
         ({x:Bind ViewModel.…}) see it on first evaluation, never newed up in XAML. -->

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DiagnosticsPanel.Padding" Value="16,16,16,24"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Grid wrapper: forces viewport-width measure so the inner panel is
             always exactly min(viewport, MaxWidth), positioned identically in
             every language. -->
        <Grid>
        <StackPanel x:Name="DiagnosticsPanel" Padding="32,24,32,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock AutomationProperties.AutomationId="DiagnosticsTitleText" Text="{loc:Loc Key=DiagnosticsTitle}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock
                Text="{loc:Loc Key=DiagnosticsDesc}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"/>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=DiagnosticsStatus}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=DiagnosticsStatus}">
                    <TextBlock
                        x:Name="StatusText"
                        AutomationProperties.AutomationId="DiagnosticsStatusText"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Right"
                        TextAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=DiagnosticsLogs}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=DiagnosticsLogs}">
                    <!-- WrapPanel (not StackPanel): longer translations wrap
                         instead of clipping on narrow windows. -->
                    <ctrl:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Right">
                        <ComboBox
                            x:Name="LogFileComboBox"
                            AutomationProperties.AutomationId="LogFileComboBox"
                            ItemsSource="{x:Bind ViewModel.LogFiles, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedLogFile, Mode=TwoWay}"
                            MinWidth="180"/>
                        <Button
                            AutomationProperties.AutomationId="RefreshLogsButton"
                            Content="{loc:Loc Key=DiagnosticsRefresh}"
                            Click="RefreshLogsButton_Click"/>
                        <Button
                            AutomationProperties.AutomationId="OpenLogFolderButton"
                            Content="{loc:Loc Key=DiagnosticsOpenFolder}"
                            Click="OpenLogFolderButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    </ctrl:WrapPanel>
                </ctk:SettingsCard>

                <!-- Filter row: search + level + copy/clear. Plain card so the
                     viewer below stays the visual focus. -->
                <ctk:SettingsCard>
                    <ctrl:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Stretch">
                        <TextBox
                            x:Name="SearchBox"
                            AutomationProperties.AutomationId="DiagnosticsSearchBox"
                            PlaceholderText="{loc:Loc Key=DiagnosticsSearchPlaceholder}"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            MinWidth="180"/>
                        <ComboBox
                            x:Name="LevelComboBox"
                            AutomationProperties.AutomationId="DiagnosticsLevelCombo"
                            SelectedIndex="{x:Bind ViewModel.SelectedLevelIndex, Mode=TwoWay}"
                            MinWidth="140">
                            <ComboBoxItem Content="{loc:Loc Key=DiagnosticsLevelAll}"/>
                            <ComboBoxItem Content="{loc:Loc Key=DiagnosticsLevelDebug}"/>
                            <ComboBoxItem Content="{loc:Loc Key=DiagnosticsLevelInfo}"/>
                            <ComboBoxItem Content="{loc:Loc Key=DiagnosticsLevelWarning}"/>
                            <ComboBoxItem Content="{loc:Loc Key=DiagnosticsLevelError}"/>
                        </ComboBox>
                        <Button
                            x:Name="CopyButton"
                            AutomationProperties.AutomationId="DiagnosticsCopyButton"
                            Content="{loc:Loc Key=DiagnosticsCopy}"
                            Click="CopyButton_Click"/>
                        <Button
                            AutomationProperties.AutomationId="DiagnosticsClearButton"
                            Content="{loc:Loc Key=DiagnosticsClear}"
                            Click="ClearButton_Click"/>
                    </ctrl:WrapPanel>
                </ctk:SettingsCard>

                <TextBlock
                    x:Name="LogCountText"
                    AutomationProperties.AutomationId="DiagnosticsLogCountText"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock
                                x:Name="LogText"
                                AutomationProperties.AutomationId="DiagnosticsLogText"
                                Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                                FontFamily="Consolas"
                                FontSize="12"
                                TextWrapping="NoWrap"
                                IsTextSelectionEnabled="True"/>
                            <!-- Empty state is a SEPARATE element: writing the
                                 placeholder into LogText would clobber the
                                 compiled binding above. -->
                            <TextBlock
                                x:Name="EmptyStateText"
                                AutomationProperties.AutomationId="DiagnosticsEmptyText"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </StackPanel>

        </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>

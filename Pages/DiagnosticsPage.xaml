<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <!-- DataContext (DiagnosticsPageViewModel) is resolved from the DI container
         in code-behind, never newed up in XAML. -->

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DiagnosticsPanel.Padding" Value="16,16,16,24"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Grid wrapper: forces viewport-width measure so the inner panel is
             always exactly min(viewport, MaxWidth), positioned identically in
             every language. -->
        <Grid>
        <StackPanel x:Name="DiagnosticsPanel" Padding="32,24,32,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock x:Name="DiagnosticsTitleText" AutomationProperties.AutomationId="DiagnosticsTitleText" Text="Diagnostics" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock
                x:Name="DiagnosticsDescText"
                Text="App status, crash reporting, and recent logs."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"/>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="DiagnosticsStatusLabel"
                    Text="STATUS"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    x:Name="StatusCard"
                    Header="Status">
                    <TextBlock
                        x:Name="StatusText"
                        AutomationProperties.AutomationId="DiagnosticsStatusText"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Right"
                        TextAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="DiagnosticsLogsLabel"
                    Text="LOGS"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    x:Name="LogsCard"
                    Header="Logs">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <ComboBox
                            x:Name="LogFileComboBox"
                            AutomationProperties.AutomationId="LogFileComboBox"
                            ItemsSource="{x:Bind ViewModel.LogFiles, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedLogFile, Mode=TwoWay}"
                            MinWidth="180"
                            HorizontalAlignment="Right"/>
                        <Button
                            x:Name="RefreshLogsButton"
                            AutomationProperties.AutomationId="RefreshLogsButton"
                            Content="Refresh"
                            Click="RefreshLogsButton_Click"/>
                        <Button
                            x:Name="OpenLogFolderButton"
                            AutomationProperties.AutomationId="OpenLogFolderButton"
                            Content="Open log folder"
                            Click="OpenLogFolderButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>
                </ctk:SettingsCard>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="LogText"
                            AutomationProperties.AutomationId="DiagnosticsLogText"
                            Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                            FontFamily="Consolas"
                            FontSize="12"
                            TextWrapping="NoWrap"
                            IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

        </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>

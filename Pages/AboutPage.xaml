<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock x:Name="AboutTitleText" Text="About" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Center">
                    <Image
                        Source="ms-appx:///Assets/Logo.png"
                        Width="48" Height="48"
                        Stretch="UniformToFill"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="DevTem-WinUI 3" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind AppVersion, Mode=OneTime}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="AboutAppInfoText"
                    Text="APP INFO"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard Header="Name">
                    <TextBlock Text="DevTem-WinUI 3" VerticalAlignment="Center"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard Header="Version">
                    <TextBlock Text="{x:Bind AppVersion, Mode=OneTime}" VerticalAlignment="Center"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard Header="Framework">
                    <TextBlock Text=".NET 10 / WinUI 3" VerticalAlignment="Center"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard Header="Platform">
                    <TextBlock Text="Windows 10/11 (x64, ARM64)" VerticalAlignment="Center"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="AboutTechnologyText"
                    Text="TECHNOLOGY"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard Header="Auto-updates">
                    <TextBlock Text="Velopack 1.2" VerticalAlignment="Center"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard Header="Logging">
                    <TextBlock Text="Serilog" VerticalAlignment="Center"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard Header="MVVM">
                    <TextBlock Text="CommunityToolkit.Mvvm" VerticalAlignment="Center"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard Header="UI Controls">
                    <TextBlock Text="CommunityToolkit.WinUI" VerticalAlignment="Center"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="AboutLicenseText"
                    Text="LICENSE"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard Header="License" Description="This software is released under the MIT License.">
                    <HyperlinkButton
                        Content="View License"
                        NavigateUri="https://github.com/Fettah010/winui-3-easy-template/blob/main/LICENSE"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    x:Name="AboutLinksText"
                    Text="LINKS"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard Header="Source Code">
                    <HyperlinkButton
                        Content="GitHub Repository"
                        NavigateUri="https://github.com/Fettah010/winui-3-easy-template"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard Header="Report Issues">
                    <HyperlinkButton
                        Content="Open Issue"
                        NavigateUri="https://github.com/Fettah010/winui-3-easy-template/issues"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard Header="Releases">
                    <HyperlinkButton
                        Content="View Releases"
                        NavigateUri="https://github.com/Fettah010/winui-3-easy-template/releases"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

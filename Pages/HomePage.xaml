<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wrap="using:DevTemWinUi3.Controls"
    xmlns:loc="using:DevTemWinUi3.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    Loaded="HomePage_Loaded"
    SizeChanged="HomePage_SizeChanged">

    <!-- Narrow stacking is driven imperatively from code-behind
         (UpdateResponsiveLayout): VisualState setters cannot reliably retarget
         Grid columns/rows, which used to leave half-applied layouts. -->
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Grid wrapper: forces viewport-width measure so the inner panel is
             always exactly min(viewport, MaxWidth), positioned identically in
             every language (a bare StackPanel sizes to its longest line). -->
        <Grid>
        <StackPanel x:Name="ContentPanel" Padding="32,24,32,32" Spacing="20" MaxWidth="980" HorizontalAlignment="Stretch">

            <!-- Hero -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
                <Grid ColumnSpacing="24" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeroLogoCol" Width="Auto"/>
                        <ColumnDefinition x:Name="HeroTextCol" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Column="0" Grid.Row="0"
                        Width="84" Height="84"
                        CornerRadius="20"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                        <Image
                            Source="ms-appx:///Assets/Logo.png"
                            Width="72" Height="72"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel x:Name="HeroText" Grid.Column="1" Grid.Row="0" Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock AutomationProperties.AutomationId="HomeTitleText" Text="{loc:Loc Key=HomeTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Border
                                VerticalAlignment="Center"
                                CornerRadius="10"
                                Padding="8,2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock
                                    Text="{x:Bind AppInfo.VersionDisplay, Mode=OneTime}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Text="{loc:Loc Key=HomeDescription}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                        <wrap:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button
                                Content="{loc:Loc Key=HomeCheckUpdates}"
                                AutomationProperties.AutomationId="HomeCheckUpdatesButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="CheckUpdatesQuickButton_Click"/>
                            <Button
                                Content="{loc:Loc Key=HomeOpenSettings}"
                                Click="OpenSettingsQuickButton_Click"/>
                            <HyperlinkButton
                                Content="{loc:Loc Key=HomeReleasesLink}"
                                NavigateUri="https://github.com/Fettah010/winui-3-easy-template/releases"/>
                        </wrap:WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status + quick actions -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="StatusCol0" Width="*"/>
                    <ColumnDefinition x:Name="StatusCol1" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border
                    Grid.Column="0" Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE930;"
                            FontSize="24"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=HomeStatusOk}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock
                                       Text="{x:Bind AppInfo.VersionDisplay, Mode=OneTime}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Status ring: a real Ellipse (a rounded Border
                             rasterizes its curve jagged at small sizes;
                             the vector ellipse stays smooth), glyph on top. -->
                        <Grid
                            Grid.Column="2"
                            Width="22" Height="22"
                            VerticalAlignment="Center">
                            <Ellipse
                                Width="22" Height="22"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <FontIcon
                                Glyph="&#xE73E;"
                                FontSize="12"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    x:Name="QuickCard"
                    Grid.Column="1" Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            Text="{loc:Loc Key=HomeQuickActions}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Loc Key=NavSettings}" Click="OpenSettingsQuickButton_Click"/>
                            <Button Content="{loc:Loc Key=NavAbout}" Click="OpenAboutQuickButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- devtem:optional:home-features — sample feature cards. Delete
                 from HERE through devtem:end:home-features for a blank
                 home (also delete FeatureCol1/FeatureCard2-4 handling in
                 HomePage.xaml.cs UpdateResponsiveLayout, and the
                 HomeFeat* keys in Services/Localization/*Strings.cs). -->
            <!-- Feature grid -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="{loc:Loc Key=HomeIncluded}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FeatureCol0" Width="*"/>
                        <ColumnDefinition x:Name="FeatureCol1" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:Loc Key=HomeFeatUpdatesTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock
                                Text="{loc:Loc Key=HomeFeatUpdatesDesc}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="FeatureCard2"
                        Grid.Row="0" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE771;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:Loc Key=HomeFeatSettingsTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock
                                Text="{loc:Loc Key=HomeFeatSettingsDesc}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="FeatureCard3"
                        Grid.Row="1" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xEADF;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:Loc Key=HomeFeatDiagnosticsTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock
                                Text="{loc:Loc Key=HomeFeatDiagnosticsDesc}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="FeatureCard4"
                        Grid.Row="1" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE96E;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:Loc Key=HomeFeatTrayTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock
                                Text="{loc:Loc Key=HomeFeatTrayDesc}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            <!-- devtem:end:home-features -->

        </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>

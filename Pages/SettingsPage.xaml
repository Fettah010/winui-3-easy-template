<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:loc="using:DevTemWinUi3.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled"
    Loaded="SettingsPage_Loaded">

    <!-- DataContext (SettingsPageViewModel) is resolved from the DI container
         in code-behind, never newed up in XAML. -->

    <Grid>
        <!-- Narrow windows get tighter page padding so cards keep breathing room. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsPanel.Padding" Value="16,16,16,24"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Grid wrapper: forces viewport-width measure so the inner panel is
             always exactly min(viewport, MaxWidth), positioned identically in
             every language. A bare StackPanel sizes to its longest unwrapped
             line, which moved the whole page when translations changed length. -->
        <Grid>
        <StackPanel x:Name="SettingsPanel" Padding="32,24,32,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock AutomationProperties.AutomationId="SettingsTitleText" Text="{loc:Loc Key=SettingsTitle}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock
                Text="{loc:Loc Key=SettingsDescription}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"/>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=SettingsAppearance}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=SettingsTheme}"
                    Description="{loc:Loc Key=SettingsThemeDesc}">
                    <ComboBox
                        x:Name="ThemeComboBox"
                        AutomationProperties.AutomationId="ThemeComboBox"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                        HorizontalAlignment="Right"
                        MinWidth="120">
                        <ComboBoxItem Content="{loc:Loc Key=SettingsThemeSystem}"/>
                        <ComboBoxItem Content="{loc:Loc Key=SettingsThemeLight}"/>
                        <ComboBoxItem Content="{loc:Loc Key=SettingsThemeDark}"/>
                    </ComboBox>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=SettingsLanguage}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard x:Name="LanguageCard" Header="{loc:Loc Key=SettingsLanguage}" Description="{loc:Loc Key=SettingsLanguageDesc}">
                    <ComboBox
                        x:Name="LanguageComboBox"
                        AutomationProperties.AutomationId="LanguageComboBox"
                        HorizontalAlignment="Right"
                        MinWidth="140"
                        SelectionChanged="LanguageComboBox_SelectionChanged"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=SettingsUpdates}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=SettingsChannelHeader}"
                    Description="{loc:Loc Key=SettingsChannelDesc}">
                    <ctk:Segmented
                        x:Name="ChannelSegment"
                        SelectedIndex="{x:Bind ViewModel.SelectedChannelIndex, Mode=TwoWay}"
                        HorizontalAlignment="Right">
                        <ctk:SegmentedItem Content="Stable"/>
                        <ctk:SegmentedItem Content="Beta"/>
                    </ctk:Segmented>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=SettingsCheckHeader}"
                    Description="{loc:Loc Key=SettingsCheckDesc}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <!-- Busy states are VM-owned props (single writer), so a
                             binding is safe here — unlike the old code-behind. -->
                        <Button
                            x:Name="CheckUpdatesButton"
                            Content="{x:Bind ViewModel.CheckUpdatesButtonText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsCheckUpdatesEnabled, Mode=OneWay}"
                            Click="CheckUpdatesButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=SettingsAutoCheckHeader}"
                    Description="{loc:Loc Key=SettingsAutoCheckDesc}">
                    <ToggleSwitch
                        x:Name="AutoCheckToggle"
                        IsOn="{x:Bind ViewModel.AutoCheckOnStartup, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    x:Name="UpdateStatusCard"
                    Header="{x:Bind ViewModel.UpdateCardHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UpdateCardDescription, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.UpdateCardVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <ProgressBar
                            x:Name="DownloadProgressBar"
                            Width="140"
                            Minimum="0"
                            Maximum="100"
                            Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                            ShowPaused="False"
                            ShowError="False"
                            Visibility="{x:Bind ViewModel.DownloadProgressVisibility, Mode=OneWay}"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            x:Name="UpdateStatusText"
                            Text="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            MaxWidth="200"
                            TextWrapping="Wrap"/>
                        <Button
                            x:Name="InstallUpdateButton"
                            Content="{x:Bind ViewModel.InstallButtonText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsInstallEnabled, Mode=OneWay}"
                            Click="InstallUpdateButton_Click"
                            Visibility="{x:Bind ViewModel.InstallButtonVisibility, Mode=OneWay}"/>
                    </StackPanel>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=SettingsSystemTray}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=SettingsMinimizeToTray}"
                    Description="{loc:Loc Key=SettingsTrayMinimizeDesc}">
                    <ToggleSwitch
                        x:Name="MinimizeToTrayToggle"
                        IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    x:Name="AutoStartCard"
                    Header="{loc:Loc Key=SettingsAutoStart}"
                    Description="{loc:Loc Key=SettingsTrayAutoStartDesc}">
                    <ToggleSwitch
                        x:Name="AutoStartToggle"
                        IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.AutoStartAvailable, Mode=OneWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=SettingsBackup}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    Header="{loc:Loc Key=SettingsBackupHeader}"
                    Description="{loc:Loc Key=SettingsBackupDesc}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button
                            AutomationProperties.AutomationId="ResetSettingsButton"
                            Content="{loc:Loc Key=SettingsReset}"
                            Command="{x:Bind ViewModel.ResetSettingsCommand}"/>
                        <Button
                            AutomationProperties.AutomationId="ExportSettingsButton"
                            Content="{loc:Loc Key=SettingsExport}"
                            Command="{x:Bind ViewModel.ExportSettingsCommand}"/>
                        <Button
                            AutomationProperties.AutomationId="ImportSettingsButton"
                            Content="{loc:Loc Key=SettingsImport}"
                            Click="ImportSettingsButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="{loc:Loc Key=SettingsAbout}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard Header="{loc:Loc Key=SettingsAppVersion}">
                    <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneTime}" VerticalAlignment="Center"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard Header="{loc:Loc Key=SettingsRepoHeader}">
                    <HyperlinkButton
                        Content="GitHub"
                        NavigateUri="https://github.com/Fettah010/winui-3-easy-template"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

        </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTemWinUi3.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:DevTemWinUi3.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:SettingsPageViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock
                Text="Customize the appearance and behavior of the app."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"/>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="APPEARANCE"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    Header="Theme"
                    Description="Choose between light, dark, or system theme.">
                    <ComboBox
                        x:Name="ThemeComboBox"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                        HorizontalAlignment="Right"
                        MinWidth="120">
                        <ComboBoxItem Content="System"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="UPDATES"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard
                    Header="Update channel"
                    Description="The channel determines which release feed the app checks for updates.">
                    <ctk:Segmented
                        x:Name="ChannelSegment"
                        SelectedIndex="{x:Bind ViewModel.SelectedChannelIndex, Mode=TwoWay}"
                        HorizontalAlignment="Right">
                        <ctk:SegmentedItem Content="Stable"/>
                        <ctk:SegmentedItem Content="Beta"/>
                        <ctk:SegmentedItem Content="Dev"/>
                    </ctk:Segmented>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Header="Check for updates on startup"
                    Description="Automatically check for updates when the app starts.">
                    <ToggleSwitch
                        x:Name="AutoCheckToggle"
                        IsOn="{x:Bind ViewModel.AutoCheckOnStartup, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock
                    Text="ABOUT"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ctk:SettingsCard Header="App version">
                    <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" VerticalAlignment="Center"/>
                </ctk:SettingsCard>

                <ctk:SettingsCard Header="Repository">
                    <HyperlinkButton
                        Content="GitHub"
                        NavigateUri="https://github.com/Fettah010/winui-3-easy-template"
                        HorizontalAlignment="Right"/>
                </ctk:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

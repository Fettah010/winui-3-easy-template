<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DevTemWinUi3.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DevTem-WinUI 3">

    <Grid x:Name="RootGrid" Opacity="0" Margin="16" CornerRadius="16"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootTransform" ScaleX="0.96" ScaleY="0.96"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main content -->
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="24"
            MaxWidth="360">

            <!-- Icon container with accent background -->
            <Grid Width="88" Height="88" HorizontalAlignment="Center">
                <Border
                    CornerRadius="20"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Opacity="0.12"/>
                <FontIcon
                    Glyph="&#xE950;"
                    FontSize="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Grid>

            <!-- App name + tagline -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock
                    Text="DevTem-WinUI 3"
                    FontSize="26"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock
                    Text="A ready-to-use template for modern Windows apps"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"/>
            </StackPanel>

            <!-- Feature chips -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="6"
                Margin="0,4,0,0">
                <Border CornerRadius="8" Padding="10,5"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                    <TextBlock Text="Auto-Updates" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
                <Border CornerRadius="8" Padding="10,5"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                    <TextBlock Text="Theme Engine" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
                <Border CornerRadius="8" Padding="10,5"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                    <TextBlock Text="System Tray" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Bottom: loader + version -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Spacing="14"
            Margin="0,0,0,20">

            <!-- Slim progress bar -->
            <ProgressRing
                x:Name="LoadingProgress"
                Width="24" Height="24"
                HorizontalAlignment="Center"
                IsActive="True"
                IsIndeterminate="True"/>

            <TextBlock
                x:Name="VersionText"
                Text="Version 0.0.1"
                FontSize="11"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                CharacterSpacing="30"/>
        </StackPanel>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DevTemWinUi3.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DevTem-WinUI 3">

    <Grid x:Name="RootGrid" Opacity="0" Background="Transparent">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootTransform" ScaleX="0.96" ScaleY="0.96"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main content: logo + name + tagline -->
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="18">

            <Border
                Width="88" Height="88"
                CornerRadius="22"
                HorizontalAlignment="Center">
                <Image
                    Source="ms-appx:///Assets/Logo.png"
                    Width="88" Height="88"
                    Stretch="UniformToFill"/>
            </Border>

            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock
                    Text="DevTem-WinUI 3"
                    FontSize="24"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock
                    Text="Modern Windows app template"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Bottom: slim loading bar + live status + version -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Spacing="8"
            Margin="0,0,0,28">

            <ProgressBar
                x:Name="LoadProgress"
                Width="220" Height="3"
                HorizontalAlignment="Center"
                Minimum="0" Maximum="100" Value="5"
                IsIndeterminate="False"
                ShowPaused="False"
                ShowError="False"/>

            <TextBlock
                x:Name="StatusText"
                Text="Loading…"
                FontSize="11"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBlock
                x:Name="VersionText"
                Text="Version 0.0.1"
                FontSize="11"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>

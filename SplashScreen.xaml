<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DevTemWinUi3.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DevTem-WinUI 3">

    <!-- Root grid with entrance animation -->
    <Grid x:Name="RootGrid" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootTransform" ScaleX="0.96" ScaleY="0.96"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main content: icon + name -->
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">

            <!-- App icon with subtle accent glow -->
            <Grid HorizontalAlignment="Center" Margin="0,0,0,4">
                <FontIcon
                    Glyph="&#xE950;"
                    FontSize="56"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Grid>

            <!-- App name -->
            <TextBlock
                Text="DevTem-WinUI 3"
                FontSize="28"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                CharacterSpacing="20"/>
        </StackPanel>

        <!-- Bottom: loading dots + version -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,36"
            Spacing="14">

            <!-- Pulsing dots loader -->
            <StackPanel
                x:Name="LoadingDots"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="8">
                <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.3"/>
                <Ellipse x:Name="Dot2" Width="5" Height="5" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.3"/>
                <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.3"/>
            </StackPanel>

            <!-- Version -->
            <TextBlock
                x:Name="VersionText"
                Text="Version 0.0.1"
                FontSize="11"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                CharacterSpacing="30"/>
        </StackPanel>
    </Grid>
</Window>

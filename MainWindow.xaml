<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DevTemWinUi3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:DevTemWinUi3.Controls"
             xmlns:ctrl="using:DevTemWinUi3.Controls"
             mc:Ignorable="d"
    Title="DevTem-WinUI 3">

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: content (and Mica) extends into the caption area,
             so the top bar follows the app theme in both light and dark mode. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="10"
                Margin="20,0,0,0"
                VerticalAlignment="Center">
                <Border
                    Width="20" Height="20"
                    CornerRadius="5"
                    VerticalAlignment="Center">
                    <Image
                        Source="ms-appx:///Assets/Logo-32.png"
                        Width="20" Height="20"
                        Stretch="UniformToFill"/>
                </Border>
                <TextBlock
                    Text="{loc:Loc Key=AppName}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Tray button: minimize to system tray (kept clear of the caption buttons) -->
            <Button
                x:Name="TrayButton"
                AutomationProperties.Name="Minimize to tray"
                Grid.Column="2"
                Width="46"
                Height="32"
                Margin="0,0,166,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                ToolTipService.ToolTip="Minimize to tray"
                Click="TrayButton_Click"
                Background="Transparent">
                <FontIcon Glyph="&#xE96E;" FontSize="14"/>
            </Button>
        </Grid>

        <!-- Overlay pane (LeftCompact): the compact rail stays inline and the
             expanded pane slides OVER the content instead of resizing it, so
             toggling never reflows, rewraps, or shifts a single pixel (the
             inline push desyncs content from the pane for a frame and snaps
             after the slide — an upstream behavior with no property fix).
             Content width only changes on real window resizes, where the
             pages' settled breakpoints apply. -->
        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsPaneOpen="False"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            IsPaneToggleButtonVisible="True"
            CompactPaneLength="48"
            ItemInvoked="NavigationView_ItemInvoked"
            BackRequested="NavigationView_BackRequested"
            OpenPaneLength="240">

            <!-- NAVIGATION SHELL — restyle freely, keep the contract:
                 - Mode: LeftCompact overlay (rail inline, drawer floats over
                   content so toggles never resize/reflow anything). Alternatives:
                   PaneDisplayMode="Left" pushes content (jitters on toggle),
                   "Top" moves nav into the top bar.
                 - Items come from Services/NavigationRegistry.cs (one list of
                   route/loc-key/icon/footer; Scripts/add-page.ps1 appends
                   there) and are built in MainWindow.xaml.cs BuildNavItems —
                   this file carries NO nav items, so restyles cannot break
                   page wiring. One item per page: Tag equals the route
                   registered in MainWindow.xaml.cs (<devtem:routes>); the
                   highlight syncs in OnNavigated. The built-in Settings item
                   is labeled in code (ApplyNavLocalization).
                 - Selection: keep the default SelectsOnInvoked=True, or the
                   current-page pill silently stops working (#6511). -->
            <!-- <devtem:nav-items> -->
            <!-- Exotic-shell fallback: shells that replace the NavigationView
                 bind Services/NavigationRegistry.MenuEntries/FooterEntries
                 themselves (or hand-place items); add-page still appends to
                 the registry, and warns when this stock NavigationView is
                 gone. This region intentionally holds no items. -->
            <!-- </devtem:nav-items> -->

            <!-- Single measure pass: the Frame fills whatever width the rail
                 leaves. No Width/Margin/Translation bindings — and the overlay
                 pane never resizes this cell at all, so toggling moves nothing. -->
            <Frame x:Name="ContentFrame"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>
        </NavigationView>

        <!-- Toast notification host: bottom-right corner. A content-sized
             StackPanel (not Canvas: zero-size Canvases park children
             off-screen) so toasts always lay out; newest inserts on top.
             Polite live region: toast arrivals announce to screen readers
             without interrupting; error cards escalate to Assertive
             themselves (NotificationCard.ApplyTypeVisuals). -->
        <StackPanel
            x:Name="NotificationHost"
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Spacing="8"
            AutomationProperties.LiveSetting="Polite"/>

        <!-- Legacy update overlay (kept wired, stays hidden): the update
             flow now uses toasts + native dialogs via UpdateDialogService. -->
        <ctrl:UpdatePopup
            x:Name="UpdatePopupControl"
            Grid.Row="0"
            Grid.RowSpan="2"/>
    </Grid>
</Window>

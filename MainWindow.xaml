<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DevTemWinUi3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DevTem-WinUI 3">

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: content (and Mica) extends into the caption area,
             so the top bar follows the app theme in both light and dark mode. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="10"
                Margin="20,0,0,0"
                VerticalAlignment="Center">
                <Border
                    Width="20" Height="20"
                    CornerRadius="5"
                    VerticalAlignment="Center">
                    <Image
                        Source="ms-appx:///Assets/Logo-32.png"
                        Width="20" Height="20"
                        Stretch="UniformToFill"/>
                </Border>
                <TextBlock
                    Text="DevTem-WinUI 3"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Tray button: minimize to system tray -->
            <Button
                x:Name="TrayButton"
                Grid.Column="2"
                Width="46"
                Height="32"
                Margin="0,0,142,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                ToolTipService.ToolTip="Minimize to tray"
                Click="TrayButton_Click"
                Background="Transparent">
                <FontIcon Glyph="&#xE96E;" FontSize="14"/>
            </Button>
        </Grid>

        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="NavigationView_ItemInvoked"
            BackRequested="NavigationView_BackRequested"
            OpenPaneLength="240">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHomeItem" Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAboutItem" Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- Toast notification host: bottom-right corner -->
        <Canvas
            x:Name="NotificationHost"
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            IsHitTestVisible="False"
            Canvas.Left="0"
            Canvas.Top="0"/>
    </Grid>
</Window>

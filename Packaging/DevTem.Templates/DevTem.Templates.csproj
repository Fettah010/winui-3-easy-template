<Project Sdk="Microsoft.NET.Sdk">

  <!-- NuGet template package: ships Templates/Page (devtem-page) and
       Templates/Project (devtem-winui) for `dotnet new install`. Versioned
       independently from the app: CI passes -p:Version from templates-v* tags.
       Pack: dotnet pack Packaging/DevTem.Templates -p:Version=0.1.0 -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>DevTem.Templates</PackageId>
    <Title>DevTem WinUI 3 starter templates (MVVM desktop app + page)</Title>
    <Authors>Fettah010</Authors>
    <Description>Production-ready WinUI 3 starter for .NET: a full MVVM desktop app (Mica window, system tray, auto-updates with Velopack/basic/none or native AppInstaller/Store options for MSIX, first-run setup wizard, SQLite + HTTP data layer, 3-language or English-only UI, persisted settings, Serilog/MEL/none logging, opt-in Entra ID auth, release pipeline) plus MVVM page scaffolders (page, list-details, datagrid, contentgrid with search/sort/paging, tabview). dotnet new devtem-winui / dotnet new devtem-contentgrid. Beyond blank templates: tray, i18n, deep links, settings backup, diagnostics. Opt-in SLNX solution file (--slnx true) plus one-command identity validation.</Description>
    <PackageTags>winui;winui-3;winui3;windows;windows-app-sdk;winappsdk;desktop;desktop-app;dotnet-new;template;templates;starter;starter-kit;boilerplate;mvvm;csharp;sqlite;velopack;auto-update;tray;i18n;localization</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>DevTem templates 0.6.0: opt-in SLNX solution file (--slnx) alongside the classic .sln, init-template -Validate v2 (repo/publisher/scheme/URL checks), VS presentation GA. Full notes: https://github.com/Fettah010/winui-3-easy-template/releases</PackageReleaseNotes>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Fettah010/winui-3-easy-template</RepositoryUrl>
    <Version>0.3.5</Version>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <!-- Template content needs dotfiles (.gitignore, .github/): disable the
         default exclusion of files starting with '.'. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- NU5100/23/28: template packages carry no lib. NU5110/11: our .ps1
         files are template content, not NuGet install scripts. -->
    <NoWarn>$(NoWarn);NU5100;NU5123;NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\Templates\Project\**\*" Exclude="..\..\Templates\Project\bin\**\*;..\..\Templates\Project\obj\**\*" PackagePath="content\Project\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\Templates\Page\**\*" Exclude="..\..\Templates\Page\bin\**\*;..\..\Templates\Page\obj\**\*" PackagePath="content\Page\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\Templates\ListDetails\**\*" Exclude="..\..\Templates\ListDetails\bin\**\*;..\..\Templates\ListDetails\obj\**\*" PackagePath="content\ListDetails\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\Templates\DataGrid\**\*" Exclude="..\..\Templates\DataGrid\bin\**\*;..\..\Templates\DataGrid\obj\**\*" PackagePath="content\DataGrid\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\Templates\TabView\**\*" Exclude="..\..\Templates\TabView\bin\**\*;..\..\Templates\TabView\obj\**\*" PackagePath="content\TabView\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\Templates\ContentGrid\**\*" Exclude="..\..\Templates\ContentGrid\bin\**\*;..\..\Templates\ContentGrid\obj\**\*" PackagePath="content\ContentGrid\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Package face: icon + readme land at the package root (not content/). -->
    <None Include="..\..\Assets\Logo.png" Pack="true" PackagePath="icon.png" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
